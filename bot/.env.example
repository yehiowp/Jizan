# ═════════════════════════════════════════════════════════════
# 1. Telegram
# ═════════════════════════════════════════════════════════════
# 跟 @BotFather 申請，/newbot 之後拿到的字串
TELEGRAM_TOKEN=123456:ABC-DEF...
# 你自己的 Telegram 數字 ID（跟 @userinfobot 說句話就會給你）
# 只有這個 ID 下的指令會被接受，其他人傳什麼都不理
OWNER_ID=123456789

# ═════════════════════════════════════════════════════════════
# 2. GMGN
# ═════════════════════════════════════════════════════════════
# ⚠️ 私鑰不寫在這裡。gmgn-cli 自己管憑證，存在 ~/.config/gmgn/.env，
#    設定方式：gmgn-cli config  →  gmgn-cli config --apply <你的 API Key>
#    這支程式不讀、不存、不傳任何憑證。
#
# 錢包位址（必須跟 API Key 綁定的那個一致）
GMGN_WALLET_ADDRESS=
CHAIN=sol

# 要掃描的鏈，逗號分隔。留空就只掃 CHAIN 那一條。
# 可用：sol / bsc / base / eth / robinhood
#   robinhood 只能掃描分析，不能下單 —— 官方幣種表沒列它的幣種地址，
#   猜一個等於拿你的錢賭我沒記錯。
# 多鏈只擴大掃描範圍；風控上限（部位數、在場資金、單日虧損）仍然全域共用。
CHAINS=sol,bsc,robinhood

# ═════════════════════════════════════════════════════════════
# 3. 交易模式
# ═════════════════════════════════════════════════════════════
# true = 只記帳、不送鏈上交易。第一週請保持 true，先看它選的幣後來怎麼走。
DRY_RUN=true

# 自動交易：機器人自己掃描、自己選幣、自己下單。
# 開了還不夠 —— 還要在 Telegram 用 /auto on 武裝，而且武裝會自己到期。
AUTO_BUY=false

# ═════════════════════════════════════════════════════════════
# 3b. 自動交易的額外限制（門檻一律比手動嚴）
# ═════════════════════════════════════════════════════════════
AUTO_MIN_SCORE=72             # 自動模式的分數門檻，不得低於 MIN_SCORE
AUTO_MAX_WARNINGS=2           # 閘門注意事項超過幾條就不買
AUTO_ALLOW_DOWNGRADE=false    # 是否接受「執行降級」訊號的單（建議 false）
AUTO_MAX_TRADES_PER_DAY=4     # 每天最多自動買幾筆
AUTO_MAX_SPEND_PER_DAY_USD=60 # 每天自動交易最多花多少
AUTO_ARM_HOURS=12             # 武裝幾小時後自動失效（最多 72）。也可以用 /auto on 2 指定更短
AUTO_DEADMAN_MINUTES=15       # 連不上 Telegram 超過幾分鐘就自動解除武裝
                              # —— 你叫不停它的時候，它不該還在自己買

# ═════════════════════════════════════════════════════════════
# 4. 風險上限（程式會硬性擋下，不是參考值）
# ═════════════════════════════════════════════════════════════
BANKROLL_USD=100          # 你放進去的總本金
POSITION_USD=20           # 每筆固定投入
MAX_OPEN_POSITIONS=3      # 同時最多幾個部位
MAX_DEPLOYED_USD=60       # 同時在場上的錢最多多少（留 40U 當備用）
MAX_DAILY_LOSS_USD=20     # 單日虧損上限，觸及就自動停止交易
KILL_SWITCH_USD=60        # 淨值跌破這個數字就全面停機
STOP_PCT=35               # 停損 %（會掛成 GMGN 伺服器端的 loss_stop）
TARGET_R=2                # 停利 = 幾倍風險 → 停利 % = STOP_PCT × TARGET_R = +70%
TRAILING_DRAWDOWN_PCT=0   # >0 就把停利改成移動停利，數字是從最高點回落幾 % 才出場

# ═════════════════════════════════════════════════════════════
# 5. 執行參數
# ═════════════════════════════════════════════════════════════
SLIPPAGE_PCT=15           # 整數 0–100。迷因幣要放寬，太低會一直失敗
GAS_TIER=average          # low / average / high（直接取 gas-price 的三檔，不自己乘係數）
TIP_FEE_SOL=0.001         # 小費。SOL 上掛停損停利時這是必填項
ANTI_MEV=true             # 防夾通道，建議一直開著
SELL_RATIO_TYPE=hold_amount   # 停損停利賣出比例的基準：hold_amount / buy_amount

# ═════════════════════════════════════════════════════════════
# 6. 篩選條件
# ═════════════════════════════════════════════════════════════
MIN_SCORE=62              # 低於這個分數不通知
MIN_DEPTH_USD=30000       # 單邊可交易深度門檻
TRENDING_INTERVAL=1h      # 1m / 5m / 1h / 6h / 24h
ALERT_COOLDOWN_HOURS=6    # 同一顆幣幾小時內不重複通知
HEARTBEAT_HOURS=12        # 每隔幾小時回報一次「我還活著」。0 = 關閉
SCAN_INTERVAL_SEC=300
MONITOR_INTERVAL_SEC=120
